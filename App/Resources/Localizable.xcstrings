    "Generations run on Higgsfield and are billed to your own account. Choose how you pay." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Генерации выполняются на Higgsfield и оплачиваются с вашего аккаунта. Выберите способ оплаты."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las generaciones se ejecutan en Higgsfield y se cobran a tu propia cuenta. Elige cómo pagar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gerações rodam na Higgsfield e são cobradas na sua própria conta. Escolha como pagar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generierungen laufen auf Higgsfield und werden über deinen eigenen Account abgerechnet. Wähle, wie du bezahlst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les générations s’exécutent sur Higgsfield et sont facturées à votre propre compte. Choisissez comment payer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成はHiggsfield上で実行され、ご自身のアカウントに請求されます。支払い方法を選んでください。"
