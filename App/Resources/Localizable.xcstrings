    "Higgsfield" : {
      "shouldTranslate" : false
    },
    "Higgsfield asks to let Jutsu for iPhone use your account. Don't Allow stops here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield спросит, разрешить ли Jutsu for iPhone доступ к аккаунту. «Don't Allow» остановит вход."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield pregunta si Jutsu for iPhone puede usar tu cuenta. «Don't Allow» lo detiene aquí."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Higgsfield pergunta se o Jutsu for iPhone pode usar sua conta. “Don't Allow” para aqui."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield fragt, ob Jutsu for iPhone dein Konto nutzen darf. „Don't Allow“ bricht hier ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield demande s’il peut laisser Jutsu for iPhone utiliser votre compte. « Don't Allow » s’arrête là."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HiggsfieldがJutsu for iPhoneにアカウントの使用を許可するか尋ねます。「Don't Allow」を選ぶとここで終わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield 会询问是否允许 Jutsu for iPhone 使用你的账户。选择“Don't Allow”会在此停止。"
          }
        }
      }
    },
    "Higgsfield reports the plan you're on, its credits and the models it has unlimited." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield сообщает ваш план, его кредиты и модели без лимита."
