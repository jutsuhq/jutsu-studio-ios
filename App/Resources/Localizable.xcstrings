    "Below this many credits the account shows a warning; 0 turns it off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter so vielen Credits zeigt das Konto eine Warnung; 0 schaltet sie aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por debajo de estos créditos la cuenta muestra un aviso; 0 lo desactiva."
