            "value" : "Отмените на любом шаге — ничего не изменится. Если вход через Higgsfield не работает, используйте API-ключ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela en cualquier paso y no cambia nada. Si el inicio de sesión de Higgsfield no funciona, usa una clave API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele em qualquer etapa e nada muda. Se o login do Higgsfield não funcionar, use uma chave de API."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brich bei jedem Schritt ab, dann ändert sich nichts. Klappt die Anmeldung bei Higgsfield nicht, nutze einen API-Schlüssel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulez à n’importe quelle étape, rien ne change. Si la connexion Higgsfield ne marche pas, utilisez une clé API."
          }
