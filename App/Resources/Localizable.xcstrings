    "Jobs over the limit wait in the queue. The change applies at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufträge über dem Limit warten in der Warteschlange. Die Änderung gilt sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los trabajos por encima del límite esperan en la cola. El cambio se aplica al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches au-delà de la limite attendent dans la file. Le changement s'applique aussitôt."
