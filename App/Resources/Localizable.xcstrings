    "The file is removed from this iPhone and the Files app. Higgsfield keeps its own copy." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл удалится с iPhone и из приложения «Файлы». Копия на Higgsfield останется."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se elimina de este iPhone y de Archivos. Higgsfield conserva su copia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo é removido deste iPhone e do app Arquivos. O Higgsfield mantém a cópia dele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird von diesem iPhone und aus „Dateien“ entfernt. Higgsfield behält seine Kopie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est supprimé de cet iPhone et de Fichiers. Higgsfield conserve sa copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはこのiPhoneと「ファイル」から削除されます。Higgsfield側のコピーは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件会从此 iPhone 和“文件” App 中移除。Higgsfield 会保留其副本。"
          }
        }
      }
    },
    "Jutsu couldn't read a file you shared. Share it again from Photos or Files." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutsu не смог прочитать отправленный файл. Поделитесь им снова из «Фото» или «Файлов»."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutsu no pudo leer un archivo que compartiste. Compártelo de nuevo desde Fotos o Archivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Jutsu não conseguiu ler um arquivo compartilhado. Compartilhe de novo pelo Fotos ou Arquivos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutsu konnte eine geteilte Datei nicht lesen. Teile sie erneut aus „Fotos“ oder „Dateien“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutsu n’a pas pu lire un fichier partagé. Partagez-le à nouveau depuis Photos ou Fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有されたファイルを読み込めませんでした。「写真」または「ファイル」からもう一度共有してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutsu 无法读取你共享的文件。请从“照片”或“文件”再次共享。"
          }
        }
      }
    },
