        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hoja de personaje muestra a una persona o animal desde todos los lados. Úsala como referencia para que sea el mismo en cada vídeo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ficha de personagem mostra uma pessoa ou animal de todos os lados. Use como referência para mantê-lo igual em todos os vídeos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Figurenblatt zeigt eine Person oder ein Tier von allen Seiten. Nutze es als Referenz, damit sie in jedem Video gleich bleiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une planche de personnage montre une personne ou un animal sous tous les angles. Utilisez-la comme référence pour qu’ils restent identiques dans chaque vidéo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャラクターシートは、人物や動物をあらゆる角度から見せるものです。参照として使えば、すべての動画で同じ姿を保てます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角色设定图会从各个角度展示某个人物或动物。将它作为参考，可让其在每个视频中保持一致。"
          }
        }
      }
    },
