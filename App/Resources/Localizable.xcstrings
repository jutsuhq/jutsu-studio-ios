    "Sign in again or replace the key to keep generating." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите снова или замените ключ, чтобы продолжить генерацию."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión de nuevo o reemplaza la clave para seguir generando."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre novamente ou substitua a chave para continuar gerando."
