    "Off: finished takes wait for Wi-Fi to download." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выкл.: готовые дубли загружаются только по Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: las tomas terminadas esperan a la conexión Wi-Fi para descargarse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: takes concluídos esperam o Wi-Fi para baixar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Fertige Takes warten zum Laden auf WLAN."
