        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже после перекодирования это видео — %1$@, что больше лимита загрузки %2$@. Выберите диапазон короче."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
