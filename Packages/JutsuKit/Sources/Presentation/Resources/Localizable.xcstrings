    "Finished Motion and Swap videos from Genjutsu, Kling and Seedance on your account appear here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся готовые видео с переносом движения и заменой от Genjutsu, Kling и Seedance с вашего аккаунта."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen los vídeos de movimiento e intercambio terminados con Genjutsu, Kling y Seedance en tu cuenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os vídeos de Movimento e Troca concluídos do Genjutsu, Kling e Seedance na sua conta aparecem aqui."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertige Motion- und Swap-Videos von Genjutsu, Kling und Seedance aus deinem Account erscheinen hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
