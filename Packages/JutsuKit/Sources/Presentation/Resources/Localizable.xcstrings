    "It leads to a web page or another kind of file. Use a direct link to the file, such as one ending in .mp4 or .jpg; pages like a YouTube video can't be downloaded." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка ведёт на веб-страницу или файл другого типа. Используйте прямую ссылку на файл, например оканчивающуюся на .mp4 или .jpg; страницы вроде видео YouTube загрузить нельзя."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva a una página web o a otro tipo de archivo. Usa un enlace directo al archivo, como uno que termine en .mp4 o .jpg; no se pueden descargar páginas como un vídeo de YouTube."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele leva a uma página da web ou a outro tipo de arquivo. Use um link direto para o arquivo, como um que termine em .mp4 ou .jpg; páginas como a de um vídeo do YouTube não podem ser baixadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er führt zu einer Webseite oder einer anderen Dateiart. Nutze einen direkten Link zur Datei, etwa auf .mp4 oder .jpg endend; Seiten wie ein YouTube-Video können nicht geladen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mène à une page web ou à un autre type de fichier. Utilisez un lien direct vers le fichier, par exemple se terminant par .mp4 ou .jpg ; les pages comme une vidéo YouTube ne peuvent pas être téléchargées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webページまたは別の種類のファイルへのリンクです。.mp4や.jpgで終わるような、ファイルへの直接リンクを使用してください。YouTubeのビデオのようなページはダウンロードできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该链接指向网页或其他类型的文件。请使用文件的直接链接，例如以 .mp4 或 .jpg 结尾的链接；YouTube 视频等页面无法下载。"
          }
        }
      }
    },
    "Jutsu Studio can't save %@: %@" : {
      "localizations" : {
