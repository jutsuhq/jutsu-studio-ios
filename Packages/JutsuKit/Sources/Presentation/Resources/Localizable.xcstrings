    "Refine the look, e.g. “warm sunset light, film grain”" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уточните образ, например «тёплый свет заката, плёночное зерно»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afina el aspecto, p. ej. «luz cálida de atardecer, grano de película»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refine o visual, p. ex. “luz quente de pôr do sol, grão de filme”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfeinere den Look, z. B. „warmes Sonnenuntergangslicht, Filmkorn“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affinez le rendu, p. ex. « lumière chaude de coucher de soleil, grain de pellicule »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルックを調整します。例：「温かな夕日の光、フィルムグレイン」"
