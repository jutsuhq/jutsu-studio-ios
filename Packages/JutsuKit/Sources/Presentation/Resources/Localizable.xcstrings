    "What happens next? e.g. “She turns around and walks to the door”" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что будет дальше? Например: «Она оборачивается и идёт к двери»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué ocurre después? p. ej. «Ella se da la vuelta y camina hacia la puerta»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que acontece depois? p. ex. “Ela se vira e caminha até a porta”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was passiert als Nächstes? z. B. „Sie dreht sich um und geht zur Tür“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que se passe-t-il ensuite ? p. ex. « Elle se retourne et marche vers la porte »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に何が起こりますか？例：「彼女は振り返り、ドアへ歩いていく」"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下来会发生什么？例如“她转过身，走向门口”"
          }
        }
      }
    },
    "What should change? e.g. “Make it night, with rain on the street”" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что нужно изменить? Например: «Сделайте ночь, на улице дождь»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué debe cambiar? p. ej. «Hazlo de noche, con lluvia en la calle»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que deve mudar? p. ex. “Faça anoitecer, com chuva na rua”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was soll sich ändern? z. B. „Mach es Nacht, mit Regen auf der Straße“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que faut-il changer ? p. ex. « Fais-le de nuit, avec de la pluie dans la rue »"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何を変更しますか？例：「夜にして、通りに雨を降らせる」"
