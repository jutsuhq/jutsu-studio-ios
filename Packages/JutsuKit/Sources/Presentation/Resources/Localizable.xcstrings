    "Styles made outside Jutsu Studio aren't listed: Higgsfield's history doesn't return them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стили, созданные вне Jutsu Studio, не показываются: история Higgsfield их не возвращает."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los estilos creados fuera de Jutsu Studio no aparecen: el historial de Higgsfield no los devuelve."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estilos criados fora do Jutsu Studio não são listados: o histórico da Higgsfield não os retorna."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb von Jutsu Studio erstellte Stile werden nicht aufgelistet: Der Verlauf von Higgsfield liefert sie nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les styles créés hors de Jutsu Studio ne sont pas listés : l’historique de Higgsfield ne les renvoie pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jutsu Studio以外で作成したスタイルは一覧に表示されません。Higgsfieldの履歴には含まれないためです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Jutsu Studio 之外制作的风格不会列出：Higgsfield 的历史记录不会返回它们。"
          }
        }
      }
    },
