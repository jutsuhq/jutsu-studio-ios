    },
    "These %lld jobs add %@, bringing today to %@ against your %@ cap." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These %1$lld jobs add %2$@, bringing today to %3$@ against your %4$@ cap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти задачи (%1$lld) добавляют %2$@, и за сегодня выйдет %3$@ при лимите %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos %1$lld trabajos suman %2$@ y llevan hoy a %3$@ frente a tu límite de %4$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes %1$lld jobs somam %2$@, levando hoje a %3$@ do seu limite de %4$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese %1$lld Jobs fügen %2$@ hinzu und bringen heute auf %3$@ bei einem Limit von %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces %1$lld tâches ajoutent %2$@, portant le total du jour à %3$@ pour un plafond de %4$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これら%1$lld件のジョブで%2$@が加算され、今日の合計は%3$@（上限は%4$@）になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这 %1$lld 个任务将增加 %2$@，使今日达到 %3$@，而你的上限为 %4$@。"
          }
        }
      }
    },
    "These %lld jobs' price isn't known, so it may take today past your %@ cap. Today is at %@ so far." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These %1$lld jobs' price isn't known, so it may take today past your %2$@ cap. Today is at %3$@ so far."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цена этих задач (%1$lld) неизвестна, поэтому сегодняшние расходы могут превысить лимит %2$@. Сейчас за сегодня: %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se conoce el precio de estos %1$lld trabajos, así que podrían llevar hoy por encima de tu límite de %2$@. Hoy van %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O preço destes %1$lld jobs é desconhecido, então eles podem levar hoje além do seu limite de %2$@. Hoje está em %3$@ até agora."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis dieser %1$lld Jobs ist unbekannt, daher kann der Tag über dein Limit von %2$@ steigen. Heute stehst du bisher bei %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix de ces %1$lld tâches est inconnu : le total du jour pourrait dépasser votre plafond de %2$@. Il est à %3$@ pour l’instant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これら%1$lld件のジョブの価格が未確定のため、今日の合計が上限%2$@を超える可能性があります。現在の合計は%3$@です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这 %1$lld 个任务的价格未知，因此可能使今日超过你的 %2$@ 上限。目前今日为 %3$@。"
          }
        }
      }
    },
