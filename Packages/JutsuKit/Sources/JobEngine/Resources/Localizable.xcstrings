          }
        }
      }
    },
    "This device is offline. Try again once it is connected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство не в сети. Повторите, когда оно подключится."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo no tiene conexión. Inténtalo de nuevo cuando se conecte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
