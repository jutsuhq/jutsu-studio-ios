          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error interno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro interno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interner Fehler."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur interne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部エラー。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内部错误。"
          }
        }
      }
    },
    "Jobs queued meanwhile took today's spend close to your cap. Try again to confirm going over it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задачи, поставленные в очередь тем временем, приблизили сегодняшние расходы к лимиту. Повторите, чтобы подтвердить превышение."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los trabajos puestos en cola entretanto acercaron el gasto de hoy a tu límite. Inténtalo de nuevo para confirmar que lo superes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs colocados na fila nesse meio-tempo aproximaram o gasto de hoje do seu limite. Tente novamente para confirmar a ultrapassagem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Zwischenzeit eingereihte Jobs haben die heutigen Ausgaben nahe an dein Limit gebracht. Versuche es erneut, um das Überschreiten zu bestätigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches mises en file entre-temps ont rapproché les dépenses du jour de votre plafond. Réessayez pour confirmer le dépassement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その間にキューに追加されたジョブにより、今日の支出が上限に近づきました。上限を超えて続けるには、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期间排队的任务使今日支出接近你的上限。请重试以确认超出上限。"
          }
        }
      }
    },
    "Only a job waiting for its turn can run next." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующей можно запустить только задачу, ожидающую своей очереди."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo un trabajo que espera su turno puede ejecutarse a continuación."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente um job esperando a vez pode ser executado a seguir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur ein Job, der auf seinen Zug wartet, kann als Nächstes laufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule une tâche en attente de son tour peut être exécutée ensuite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "順番待ちのジョブのみ、次に実行できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有轮到排队的任务才能下一个运行。"
          }
        }
      }
    },
    "The file is larger than %@, so it wasn't downloaded." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл больше %@, поэтому он не загружен."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo supera %@, por lo que no se descargó."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo é maior que %@, então não foi baixado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist größer als %@ und wurde daher nicht geladen."
          }
        },
        "fr" : {
          "stringUnit" : {
