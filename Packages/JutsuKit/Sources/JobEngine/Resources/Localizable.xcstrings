{
  "sourceLanguage" : "en",
  "strings" : {
    "Connect the Higgsfield account or API key this job was made with, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите аккаунт Higgsfield или ключ API, с которым была создана эта задача, и повторите."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta la cuenta de Higgsfield o la clave de API con la que se creó este trabajo e inténtalo de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte a conta Higgsfield ou a chave de API com que este job foi criado e tente novamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde den Higgsfield-Account oder API-Schlüssel, mit dem dieser Job erstellt wurde, und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez le compte Higgsfield ou la clé API avec lesquels cette tâche a été créée, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このジョブの作成に使用したHiggsfieldアカウントまたはAPIキーに接続してから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请连接制作此任务所用的 Higgsfield 账户或 API 密钥，然后重试。"
          }
        }
      }
    },
    "Higgsfield is already making this job, so it can't be canceled." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield уже выполняет эту задачу, поэтому её нельзя отменить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield ya está creando este trabajo, así que no se puede cancelar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Higgsfield já está criando este job, então ele não pode ser cancelado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield erstellt diesen Job bereits, daher kann er nicht abgebrochen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield est déjà en train d’exécuter cette tâche : elle ne peut pas être annulée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfieldがすでにこのジョブを作成中のため、キャンセルできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield 已在处理此任务，因此无法取消。"
          }
        }
      }
    },
    "Higgsfield may already be starting this job. Cancel it once it shows as queued." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield, возможно, уже запускает эту задачу. Отмените её, когда она появится в очереди."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que Higgsfield ya esté iniciando este trabajo. Cancélalo cuando aparezca en cola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Higgsfield pode já estar iniciando este job. Cancele-o quando aparecer como na fila."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield startet diesen Job womöglich schon. Brich ihn ab, sobald er als eingereiht angezeigt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield est peut-être déjà en train de démarrer cette tâche. Annulez-la une fois qu’elle apparaît en file d’attente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfieldがすでにこのジョブを開始しようとしている可能性があります。待機中と表示されてからキャンセルしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield 可能已在启动此任务。待其显示为已排队后再取消。"
          }
        }
      }
    },
    "Higgsfield refused to send the result (HTTP %lld). Retry to download it again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield отказался отправить результат (HTTP %lld). Повторите, чтобы загрузить его снова."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield se negó a enviar el resultado (HTTP %lld). Reintenta para descargarlo de nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Higgsfield recusou enviar o resultado (HTTP %lld). Tente novamente para baixá-lo de novo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield hat das Senden des Ergebnisses verweigert (HTTP %lld). Wiederhole den Download."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield a refusé d’envoyer le résultat (HTTP %lld). Réessayez pour le télécharger de nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfieldが結果の送信を拒否しました（HTTP %lld）。再試行して、もう一度ダウンロードしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higgsfield 拒绝发送结果（HTTP %lld）。请重试以再次下载。"
          }
        }
      }
    },
    "Internal error." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
