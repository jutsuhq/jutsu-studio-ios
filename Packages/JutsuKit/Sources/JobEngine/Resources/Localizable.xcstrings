    "This job was saved without its Higgsfield request, so its result can't be found." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта задача сохранена без запроса Higgsfield, поэтому её результат не найти."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este trabajo se guardó sin su solicitud de Higgsfield, así que no se encuentra su resultado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este job foi salvo sem a solicitação à Higgsfield, então seu resultado não pode ser encontrado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Job wurde ohne seine Higgsfield-Anfrage gesichert, daher ist sein Ergebnis nicht auffindbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
