{
  "sourceLanguage" : "en",
  "strings" : {
    "Today's spending couldn't be read. Nothing was sent. Repair the spending data or turn off the daily cap in Settings." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расходы за сегодня не удалось прочитать. Ничего не отправлено. Восстановите данные о расходах или отключите дневной лимит в настройках."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el gasto de hoy. No se envió nada. Repara los datos de gasto o desactiva el límite diario en Ajustes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o gasto de hoje. Nada foi enviado. Repare os dados de gastos ou desative o limite diário em Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heutigen Ausgaben konnten nicht gelesen werden. Nichts wurde gesendet. Repariere die Ausgabendaten oder schalte das Tageslimit in den Einstellungen aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses du jour n’ont pas pu être lues. Rien n’a été envoyé. Réparez les données de dépenses ou désactivez le plafond quotidien dans Réglages."
          }
